# Grand Horizon Hotel - Environment Variables Example
# Copy this file to .env and customize for your local setup. Do NOT commit .env to version control.

# Server Port
PORT=3000

# MongoDB Connection URI & Database Name
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=grand_horizon_hotel

# JWT Secret Key for Session Signing (use a long random string in production)
JWT_SECRET=replace-with-secure-random-secret-key

# Set to 'true' in production to redirect HTTP traffic to HTTPS and send HSTS headers
FORCE_HTTPS=false
